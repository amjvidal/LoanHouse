rules_version = '2';

// Só entra quem tem login E um documento em /usuarios/{uid} (criado à mão no console pelo Mário).
// O script de verificação diária usa a conta de serviço (Admin SDK), que não passa por estas regras.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function autorizado() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function textoNaoVazio(valor) {
      return valor is string && valor.size() > 0;
    }

    function situacaoValida(s) {
      return s in ['vaga', 'alugada', 'atrasada'];
    }

    function estadoCivilValido(ec) {
      return ec in ['solteiro', 'casado', 'divorciado', 'viuvo', 'uniao_estavel'];
    }

    function statusContratoValido(s) {
      return s in ['ativo', 'encerrado'];
    }

    function statusPagamentoValido(s) {
      return s in ['pendente', 'pago', 'atrasado'];
    }

    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    match /casas/{codigo} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado()
        && codigo.matches('^[A-Z]{3}-[0-9A-Z]+(-[0-9]+)?$')
        && request.resource.data.codigo == codigo
        && situacaoValida(request.resource.data.situacao);

      match /reclamacoes/{id} {
        allow read, write: if autorizado();
      }
      match /contas/{id} {
        allow read, write: if autorizado();
      }
    }

    match /inquilinos/{id} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado()
        && textoNaoVazio(request.resource.data.nomeCompleto)
        && textoNaoVazio(request.resource.data.cpf)
        && textoNaoVazio(request.resource.data.telefone)
        && (!('estadoCivil' in request.resource.data) || estadoCivilValido(request.resource.data.estadoCivil));

      match /fiadores/{fiadorId} {
        allow read, delete: if autorizado();
        allow create, update: if autorizado()
          && textoNaoVazio(request.resource.data.nomeCompleto)
          && textoNaoVazio(request.resource.data.cpf)
          && textoNaoVazio(request.resource.data.telefone)
          && textoNaoVazio(request.resource.data.endereco);
      }
    }

    match /contratos/{id} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado()
        && statusContratoValido(request.resource.data.status)
        && textoNaoVazio(request.resource.data.casaId)
        && textoNaoVazio(request.resource.data.inquilinoId)
        && request.resource.data.valorAluguel is number
        && request.resource.data.valorAluguel > 0
        && request.resource.data.diaVencimento is int
        && request.resource.data.diaVencimento >= 1
        && request.resource.data.diaVencimento <= 31;
    }

    match /pagamentos/{id} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado()
        && statusPagamentoValido(request.resource.data.status);
    }

    match /eventos/{id} {
      allow read, write: if autorizado();
    }

    match /parceiros/{id} {
      allow read, write: if autorizado();
    }

    match /estoque/{id} {
      allow read, write: if autorizado();
    }
  }
}
